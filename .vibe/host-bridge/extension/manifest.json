{
  "manifest_version": 3,
  "name": "Resort Empire Host Relay",
  "version": "0.1.1",
  "description": "Narrow relay between the bound Resort Empire ChatGPT Project and the loopback Resort host bridge.",
  "host_permissions": [
    "https://chatgpt.com/*",
    "http://127.0.0.1:18765/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ]
}